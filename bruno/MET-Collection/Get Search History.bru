meta {
  name: Get Search History
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/users/search-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Get search history should be successful", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.be.an('array');
  });
}
