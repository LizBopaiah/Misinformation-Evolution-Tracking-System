meta {
  name: Search History
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/search-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Search history list should return successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.be.an('array');
  });
}
