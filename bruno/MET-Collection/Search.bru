meta {
  name: Search
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/search
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "query": "COVID vaccine infertility"
  }
}

tests {
  test("Search query should execute successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.query).to.equal("COVID vaccine infertility");
    expect(res.getBody().data.fact_check_result).to.be.a('string');
    expect(res.getBody().data.summary).to.be.a('string');
    expect(res.getBody().data.articles).to.be.an('array');
  });
}
